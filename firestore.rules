rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is the admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'alvarocastrovalverde@gmail.com';
    }

    // Albums: Anyone can read, only admin can write
    match /albums/{albumId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Daily History: Anyone can read, only admin can write
    match /daily_history/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Badges: Anyone can read (for display), only admin can write
    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Users: Anyone can read (for search/ranking), users can only write their own data
    match /users/{userId} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      
      // Followers/Following subcollections
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      }
    }
    
    // Comments: Anyone can read, users can create/vote, admin/owner can delete
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null; // For voting
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
    }

    // Activities: Only writeable by the user themselves
    match /activities/{activityId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
    }
  }
}
